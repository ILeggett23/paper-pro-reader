+
+#include <QQuickPaintedItem>
+#include <QString>
+
+#include <atomic>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <vector>
+
+class QPainter;
+
+class NativeInkOverlay : public QQuickPaintedItem {
+    Q_OBJECT
+    Q_PROPERTY(bool sessionEnabled READ sessionEnabled WRITE setSessionEnabled NOTIFY sessionEnabledChanged)
+    Q_PROPERTY(bool sessionActive READ sessionActive NOTIFY sessionActiveChanged)
+    Q_PROPERTY(bool markerInProximity READ markerInProximity NOTIFY markerInProximityChanged)
+    Q_PROPERTY(bool rearEraserSelected READ rearEraserSelected NOTIFY rearEraserSelectedChanged)
+    Q_PROPERTY(int framebufferID READ framebufferID WRITE setFramebufferID NOTIFY framebufferIDChanged)
+    Q_PROPERTY(QString diagnosticsSummary READ diagnosticsSummary NOTIFY diagnosticsChanged)
+
+public:
+    explicit NativeInkOverlay(QQuickItem *parent = nullptr);
+    ~NativeInkOverlay() override;
+
+    bool sessionEnabled() const { return sessionEnabled_; }
+    bool sessionActive() const { return sessionActive_; }
+    void setSessionEnabled(bool enabled);
+    bool markerInProximity() const { return markerInProximity_; }
+    bool rearEraserSelected() const { return rearEraserSelected_; }
+    int framebufferID() const { return framebufferID_; }
+    void setFramebufferID(int framebufferID);
+    QString diagnosticsSummary() const;
+
+    Q_INVOKABLE void clearPreview();
+
+    void paint(QPainter *painter) override;
+
+signals:
+    void sessionEnabledChanged();
+    void sessionActiveChanged();
+    void markerInProximityChanged();
+    void rearEraserSelectedChanged();
+    void framebufferIDChanged();
+    void diagnosticsChanged();
+
+private:
+    struct Stroke {
+        std::uint64_t id = 0;
+        std::vector<nativeink::Point> points;
+    };
+
+    struct QueuedEvent {
+        enum class Kind { Pen, Touch } kind = Kind::Pen;
+        nativeink::PenSample pen;
+        nativeink::TouchFrame touch;
+    };
+
+    void startSession();
+    void stopSession();
+    void enqueuePen(const nativeink::PenSample &sample);
+    void enqueueTouch(const nativeink::TouchFrame &frame);
+    void enqueue(QueuedEvent event);
+    void drainEvents();
+    nativeink::RectF processPen(const nativeink::PenSample &sample);
+    void processTouch(const nativeink::TouchFrame &frame);
+    nativeink::RectF beginContact(const nativeink::PenSample &sample);
+    nativeink::RectF appendContactPoint(const nativeink::PenSample &sample);
+    nativeink::RectF finishContact(const nativeink::PenSample &sample);
+    nativeink::RectF eraseAt(const nativeink::Point &point);
+    nativeink::RectF eraserCursorBounds() const;
+    void sendHello(std::uint64_t timestampNs);
+    void flushPointBatch(bool finalChunk);
+    nativeink::Metrics metricsSnapshot() const;
+    static std::uint64_t monotonicNs();
+    static std::uint32_t toolFlags(nativeink::Tool tool, std::uint32_t flags = 0);
+    static nativeink::PointF pointF(const nativeink::Point &point);
+    static std::vector<nativeink::PointF> pointVector(const Stroke &stroke);
+
+    bool sessionEnabled_ = false;
+    bool sessionActive_ = false;
+    bool markerInProximity_ = false;
+    bool rearEraserSelected_ = false;
+    bool contactDown_ = false;
+    int framebufferID_ = -1;
+    QString startupError_;
+    nativeink::Tool activeTool_ = nativeink::Tool::None;
+    std::uint64_t activeStrokeID_ = 0;
+    std::uint64_t nextStrokeID_ = 0;
+    std::uint64_t messageSequence_ = 0;
+
+    Stroke activeStroke_;
+    std::vector<Stroke> completedStrokes_;
+    std::vector<nativeink::Point> pendingPoints_;
+    nativeink::PointF eraserCursor_;
+    bool eraserCursorVisible_ = false;
+    static constexpr float kPenWidth = 3.0F;
+    static constexpr float kEraserRadius = 24.0F;
+
+    nativeink::NativeInkInput input_;
+    nativeink::NativeInkIpcServer ipc_;
+    std::mutex queueMutex_;
+    std::deque<QueuedEvent> eventQueue_;
+    std::atomic<bool> drainScheduled_{false};
+    static constexpr std::size_t kMaxQueuedEvents = 1024U;
+
+    std::atomic<std::uint64_t> rawSamplesReceived_{0};
+    std::atomic<std::uint64_t> samplesRendered_{0};
+    std::atomic<std::uint64_t> samplesHandedToClient_{0};
+    std::atomic<std::uint64_t> samplesDropped_{0};
+    std::atomic<std::uint64_t> displayUpdatesSubmitted_{0};
+    std::atomic<std::uint64_t> displayUpdatesCoalesced_{0};
+    std::atomic<std::uint64_t> paintCalls_{0};
+    std::atomic<std::uint64_t> paintTimeUs_{0};
+    std::atomic<std::uint64_t> rawToReceiptUs_{0};
+    std::atomic<std::uint64_t> rawToReceiptCount_{0};
+    std::atomic<std::uint64_t> receiptToSubmitUs_{0};
+    std::atomic<std::uint64_t> receiptToSubmitCount_{0};
+    std::atomic<std::uint64_t> eventToSubmitUs_{0};
+    std::atomic<std::uint64_t> eventToSubmitCount_{0};
+};
diff --git a/src/nativeink/NativeInkProtocol.h b/src/nativeink/NativeInkProtocol.h
new file mode 100644
index 0000000..5e6a452
--- /dev/null
+++ b/src/nativeink/NativeInkProtocol.h
@@ -0,0 +1,151 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <type_traits>
+
+namespace nativeink {
+
+constexpr std::uint32_t kMagic = 0x314b4e49U; // "INK1" on little-endian targets.
+constexpr std::uint16_t kProtocolMajor = 1;
+constexpr std::uint16_t kProtocolMinor = 0;
+constexpr std::uint32_t kMaxPayloadBytes = 32U * 1024U;
+constexpr std::uint32_t kMaxPointsPerPacket = 128U;
+constexpr std::uint32_t kMaxPointsPerStroke = 10000U;
+constexpr std::uint32_t kMaxTouchSlots = 10U;
+
+enum class MessageType : std::uint16_t {
+    Hello = 1,
+    StrokeBegin = 2,
+    StrokePoints = 3,
+    StrokeEnd = 4,
+    EraseBegin = 5,
+    ErasePoints = 6,
+    EraseEnd = 7,
+    Metrics = 8,
+    Goodbye = 9,
+};
+
+enum class Tool : std::uint16_t {
+    None = 0,
+    Pen = 1,
+    RearEraser = 2,
+};
+
+enum Capability : std::uint32_t {
+    CapabilityPen = 1U << 0U,
+    CapabilityRearEraser = 1U << 1U,
+    CapabilityPressure = 1U << 2U,
+    CapabilityDistance = 1U << 3U,
+    CapabilityTilt = 1U << 4U,
+    CapabilityTouchMajor = 1U << 5U,
+    CapabilityTouchPressure = 1U << 6U,
+    CapabilityTouchToolType = 1U << 7U,
+};
+
+enum HeaderFlag : std::uint32_t {
+    FlagContact = 1U << 0U,
+    FlagProximity = 1U << 1U,
+    FlagFinalChunk = 1U << 2U,
+    FlagClockMonotonic = 1U << 3U,
+};
+
+#pragma pack(push, 1)
+struct Header {
+    std::uint32_t magic = kMagic;
+    std::uint16_t protocolMajor = kProtocolMajor;
+    std::uint16_t protocolMinor = kProtocolMinor;
+    std::uint16_t messageType = 0;
+    std::uint16_t headerBytes = sizeof(Header);
+    std::uint32_t payloadBytes = 0;
+    std::uint64_t sequence = 0;
+    std::uint64_t timestampNs = 0;
+    std::uint64_t strokeId = 0;
+    std::uint32_t flags = 0;
+    std::uint32_t pointCount = 0;
+};
+
+struct Point {
+    float x = 0.0F;
+    float y = 0.0F;
+    std::uint64_t timestampNs = 0;
+    std::uint16_t pressure = 0;
+    std::int16_t tiltX = 0;
+    std::int16_t tiltY = 0;
+    std::uint16_t tool = static_cast<std::uint16_t>(Tool::None);
+};
+
+struct Hello {
+    std::uint32_t screenWidth = 0;
+    std::uint32_t screenHeight = 0;
+    std::uint32_t capabilities = 0;
+    std::uint32_t maxPointsPerPacket = kMaxPointsPerPacket;
+    std::uint32_t maxPointsPerStroke = kMaxPointsPerStroke;
+    std::uint32_t maxTouchSlots = kMaxTouchSlots;
+    std::uint32_t reserved0 = 0;
+    std::uint32_t reserved1 = 0;
+};
+
+struct Metrics {
+    std::uint64_t rawSamplesReceived = 0;
+    std::uint64_t samplesRendered = 0;
+    std::uint64_t samplesHandedToClient = 0;
+    std::uint64_t samplesDropped = 0;
+    std::uint64_t displayUpdatesSubmitted = 0;
+    std::uint64_t displayUpdatesCoalesced = 0;
+    std::uint64_t paintCalls = 0;
+    std::uint64_t paintTimeUs = 0;
+    std::uint64_t rawToReceiptUs = 0;
+    std::uint64_t rawToReceiptCount = 0;
+    std::uint64_t receiptToSubmitUs = 0;
+    std::uint64_t receiptToSubmitCount = 0;
+    std::uint64_t eventToSubmitUs = 0;
+    std::uint64_t eventToSubmitCount = 0;
+};
+#pragma pack(pop)
+
+static_assert(std::is_trivially_copyable_v<Header>);
+static_assert(std::is_trivially_copyable_v<Point>);
+static_assert(sizeof(Header) == 48U);
+static_assert(sizeof(Point) == 24U);
+static_assert(sizeof(Hello) == 32U);
+static_assert(sizeof(Metrics) == 112U);
+
+inline bool isKnownType(std::uint16_t rawType)
+{
+    switch (static_cast<MessageType>(rawType)) {
+    case MessageType::Hello:
+    case MessageType::StrokeBegin:
+    case MessageType::StrokePoints:
+    case MessageType::StrokeEnd:
+    case MessageType::EraseBegin:
+    case MessageType::ErasePoints:
+    case MessageType::EraseEnd:
+    case MessageType::Metrics:
+    case MessageType::Goodbye:
+        return true;
+    }
+    return false;
+}
+
+inline bool validateHeader(const Header &header)
+{
+    if (header.magic != kMagic || header.protocolMajor != kProtocolMajor)
+        return false;
+    if (header.headerBytes != sizeof(Header) || !isKnownType(header.messageType))
+        return false;
+    if (header.payloadBytes > kMaxPayloadBytes || header.pointCount > kMaxPointsPerPacket)
+        return false;
+    if ((header.messageType == static_cast<std::uint16_t>(MessageType::StrokePoints)
+            || header.messageType == static_cast<std::uint16_t>(MessageType::ErasePoints))
+        && header.payloadBytes != header.pointCount * sizeof(Point))
+        return false;
+    return true;
+}
+
+inline std::size_t packetBytes(const Header &header)
+{
+    return static_cast<std::size_t>(header.headerBytes) + header.payloadBytes;
+}
+
+} // namespace nativeink
