diff --git a/src/nativeink/NativeInkGeometry.h b/src/nativeink/NativeInkGeometry.h
new file mode 100644
index 0000000..c4f14d7
--- /dev/null
+++ b/src/nativeink/NativeInkGeometry.h
@@ -0,0 +1,88 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+namespace nativeink {
+
+struct PointF {
+    float x = 0.0F;
+    float y = 0.0F;
+};
+
+struct RectF {
+    float x = 0.0F;
+    float y = 0.0F;
+    float width = 0.0F;
+    float height = 0.0F;
+
+    bool valid() const { return width > 0.0F && height > 0.0F; }
+};
+
+inline RectF unite(const RectF &left, const RectF &right)
+{
+    if (!left.valid()) return right;
+    if (!right.valid()) return left;
+    const float x0 = std::min(left.x, right.x);
+    const float y0 = std::min(left.y, right.y);
+    const float x1 = std::max(left.x + left.width, right.x + right.width);
+    const float y1 = std::max(left.y + left.height, right.y + right.height);
+    return {x0, y0, x1 - x0, y1 - y0};
+}
+
+inline RectF segmentBounds(const PointF &a, const PointF &b, float radius, float margin = 2.0F)
+{
+    const float inset = std::max(0.0F, radius) + std::max(0.0F, margin);
+    const float x0 = std::min(a.x, b.x) - inset;
+    const float y0 = std::min(a.y, b.y) - inset;
+    const float x1 = std::max(a.x, b.x) + inset;
+    const float y1 = std::max(a.y, b.y) + inset;
+    return {x0, y0, x1 - x0, y1 - y0};
+}
+
+inline float pointToSegmentDistanceSquared(const PointF &point, const PointF &a, const PointF &b)
+{
+    const float abX = b.x - a.x;
+    const float abY = b.y - a.y;
+    const float lengthSquared = abX * abX + abY * abY;
+    if (lengthSquared <= 1.0e-8F) {
+        const float dx = point.x - a.x;
+        const float dy = point.y - a.y;
+        return dx * dx + dy * dy;
+    }
+    const float projection = std::clamp(
+        ((point.x - a.x) * abX + (point.y - a.y) * abY) / lengthSquared,
+        0.0F, 1.0F);
+    const float projectedX = a.x + projection * abX;
+    const float projectedY = a.y + projection * abY;
+    const float dx = point.x - projectedX;
+    const float dy = point.y - projectedY;
+    return dx * dx + dy * dy;
+}
+
+inline bool strokeHit(const std::vector<PointF> &points, const PointF &point, float radius)
+{
+    if (points.empty()) return false;
+    const float radiusSquared = radius * radius;
+    if (points.size() == 1U)
+        return pointToSegmentDistanceSquared(point, points.front(), points.front()) <= radiusSquared;
+    for (std::size_t i = 1; i < points.size(); ++i) {
+        if (pointToSegmentDistanceSquared(point, points[i - 1U], points[i]) <= radiusSquared)
+            return true;
+    }
+    return false;
+}
+
+inline RectF strokeBounds(const std::vector<PointF> &points, float radius, float margin = 2.0F)
+{
+    RectF result;
+    if (points.empty()) return result;
+    if (points.size() == 1U)
+        return segmentBounds(points.front(), points.front(), radius, margin);
+    for (std::size_t i = 1; i < points.size(); ++i)
+        result = unite(result, segmentBounds(points[i - 1U], points[i], radius, margin));
+    return result;
+}
+
+} // namespace nativeink
diff --git a/src/nativeink/NativeInkInput.cpp b/src/nativeink/NativeInkInput.cpp
new file mode 100644
index 0000000..cfae8ef
--- /dev/null
+++ b/src/nativeink/NativeInkInput.cpp
@@ -0,0 +1,254 @@
+#include "NativeInkInput.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+#include <fcntl.h>
+#include <linux/input.h>
+#include <poll.h>
+#include <sys/ioctl.h>
+#include <time.h>
+#include <unistd.h>
+#include <utility>
+
+namespace nativeink {
+
+namespace {
+
+constexpr std::size_t kEventsPerRead = 128U;
+
+int openReadOnlyEventNode(const std::string &path)
+{
+    return ::open(path.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+}
+
+} // namespace
+
+NativeInkInput::NativeInkInput() = default;
+
+NativeInkInput::~NativeInkInput()
+{
+    stop();
+}
+
+bool NativeInkInput::start(const std::string &penPath, const std::string &touchPath,
+                           PenCallback penCallback, TouchCallback touchCallback)
+{
+    if (running()) return true;
+    lastError_.clear();
+    capabilities_ = 0;
+    penFd_ = openReadOnlyEventNode(penPath);
+    if (penFd_ < 0) {
+        lastError_ = "open_pen_failed:" + std::to_string(errno);
+        return false;
+    }
+    touchFd_ = openReadOnlyEventNode(touchPath);
+    if (touchFd_ < 0) {
+        lastError_ = "open_touch_failed:" + std::to_string(errno);
+        ::close(penFd_);
+        penFd_ = -1;
+        return false;
+    }
+    if (!configurePen() || !configureTouch()) {
+        ::close(penFd_);
+        ::close(touchFd_);
+        penFd_ = touchFd_ = -1;
+        return false;
+    }
+
+    penCallback_ = std::move(penCallback);
+    touchCallback_ = std::move(touchCallback);
+    running_.store(true);
+    thread_ = std::thread([this]() { readerLoop(); });
+    return true;
+}
+
+void NativeInkInput::stop()
+{
+    running_.store(false);
+    if (thread_.joinable()) thread_.join();
+    if (penFd_ >= 0) ::close(penFd_);
+    if (touchFd_ >= 0) ::close(touchFd_);
+    penFd_ = touchFd_ = -1;
+    penCallback_ = {};
+    touchCallback_ = {};
+}
+
+NativeInkInput::AxisRange NativeInkInput::queryAxis(int fd, unsigned axis)
+{
+    struct input_absinfo information {};
+    if (::ioctl(fd, EVIOCGABS(axis), &information) < 0)
+        return {};
+    AxisRange range;
+    range.minimum = information.minimum;
+    range.maximum = information.maximum > information.minimum
+        ? information.maximum : information.minimum + 1;
+    range.available = true;
+    return range;
+}
+
+bool NativeInkInput::configurePen()
+{
+    penX_ = queryAxis(penFd_, ABS_X);
+    penY_ = queryAxis(penFd_, ABS_Y);
+    penPressure_ = queryAxis(penFd_, ABS_PRESSURE);
+    if (!penX_.available || !penY_.available) {
+        lastError_ = "pen_axes_unavailable";
+        return false;
+    }
+    capabilities_ |= CapabilityPen | CapabilityRearEraser;
+    if (penPressure_.available) capabilities_ |= CapabilityPressure;
+    if (queryAxis(penFd_, ABS_DISTANCE).available) capabilities_ |= CapabilityDistance;
+    if (queryAxis(penFd_, ABS_TILT_X).available && queryAxis(penFd_, ABS_TILT_Y).available)
+        capabilities_ |= CapabilityTilt;
+    return true;
+}
+
+bool NativeInkInput::configureTouch()
+{
+    touchX_ = queryAxis(touchFd_, ABS_MT_POSITION_X);
+    touchY_ = queryAxis(touchFd_, ABS_MT_POSITION_Y);
+    if (!touchX_.available || !touchY_.available) {
+        lastError_ = "touch_axes_unavailable";
+        return false;
+    }
+    if (queryAxis(touchFd_, ABS_MT_TOUCH_MAJOR).available)
+        capabilities_ |= CapabilityTouchMajor;
+    if (queryAxis(touchFd_, ABS_MT_PRESSURE).available)
+        capabilities_ |= CapabilityTouchPressure;
+    if (queryAxis(touchFd_, ABS_MT_TOOL_TYPE).available)
+        capabilities_ |= CapabilityTouchToolType;
+    return true;
+}
+
+float NativeInkInput::normalize(int value, const AxisRange &range)
+{
+    if (!range.available || range.maximum <= range.minimum) return 0.0F;
+    const float result = static_cast<float>(value - range.minimum)
+        / static_cast<float>(range.maximum - range.minimum);
+    return std::clamp(result, 0.0F, 1.0F);
+}
+
+std::uint64_t NativeInkInput::eventTimestampNs(long seconds, long microseconds)
+{
+    if (seconds < 0 || microseconds < 0) return 0;
+    return static_cast<std::uint64_t>(seconds) * UINT64_C(1000000000)
+        + static_cast<std::uint64_t>(microseconds) * UINT64_C(1000);
+}
+
+std::uint64_t NativeInkInput::monotonicNs()
+{
+    struct timespec now {};
+    if (::clock_gettime(CLOCK_MONOTONIC, &now) != 0) return 0;
+    return static_cast<std::uint64_t>(now.tv_sec) * UINT64_C(1000000000)
+        + static_cast<std::uint64_t>(now.tv_nsec);
+}
+
+void NativeInkInput::readerLoop()
+{
+    struct pollfd descriptors[2] = {
+        {penFd_, POLLIN, 0},
+        {touchFd_, POLLIN, 0},
+    };
+    std::array<struct input_event, kEventsPerRead> events {};
+
+    while (running_.load()) {
+        const int ready = ::poll(descriptors, 2, 100);
+        if (ready < 0) {
+            if (errno == EINTR) continue;
+            lastError_ = "poll_failed:" + std::to_string(errno);
+            break;
+        }
+
+        if ((descriptors[0].revents & POLLIN) != 0) {
+            const ssize_t bytes = ::read(penFd_, events.data(), sizeof(events));
+            const std::size_t count = bytes > 0
+                ? static_cast<std::size_t>(bytes) / sizeof(struct input_event) : 0U;
+            for (std::size_t index = 0; index < count; ++index) {
+                const auto &event = events[index];
+                if (event.type == EV_ABS) {
+                    switch (event.code) {
+                    case ABS_X: rawPenX_ = event.value; break;
+                    case ABS_Y: rawPenY_ = event.value; break;
+                    case ABS_PRESSURE: rawPressure_ = event.value; break;
+                    case ABS_DISTANCE: rawDistance_ = event.value; break;
+                    case ABS_TILT_X: rawTiltX_ = event.value; break;
+                    case ABS_TILT_Y: rawTiltY_ = event.value; break;
+                    default: break;
+                    }
+                } else if (event.type == EV_KEY) {
+                    if (event.code == BTN_TOOL_PEN) penTool_ = event.value != 0;
+                    else if (event.code == BTN_TOOL_RUBBER) rubberTool_ = event.value != 0;
+                    else if (event.code == BTN_TOUCH) penContact_ = event.value != 0;
+                } else if (event.type == EV_SYN && event.code == SYN_REPORT && penCallback_) {
+                    PenSample sample;
+                    sample.normalizedX = normalize(rawPenX_, penX_);
+                    sample.normalizedY = normalize(rawPenY_, penY_);
+                    sample.eventTimestampNs = eventTimestampNs(event.time.tv_sec, event.time.tv_usec);
+                    sample.receiptTimestampNs = monotonicNs();
+                    sample.sequence = ++sequence_;
+                    sample.pressure = static_cast<std::uint16_t>(std::clamp(rawPressure_, 0, 65535));
+                    sample.tiltX = static_cast<std::int16_t>(std::clamp(rawTiltX_, -32768, 32767));
+                    sample.tiltY = static_cast<std::int16_t>(std::clamp(rawTiltY_, -32768, 32767));
+                    sample.distance = static_cast<std::uint32_t>(std::max(rawDistance_, 0));
+                    sample.tool = rubberTool_ ? Tool::RearEraser : penTool_ ? Tool::Pen : Tool::None;
+                    sample.proximity = penTool_ || rubberTool_;
+                    sample.contact = penContact_ && sample.proximity;
+                    penCallback_(sample);
+                }
+            }
+        }
+
+        if ((descriptors[1].revents & POLLIN) != 0) {
+            const ssize_t bytes = ::read(touchFd_, events.data(), sizeof(events));
+            const std::size_t count = bytes > 0
+                ? static_cast<std::size_t>(bytes) / sizeof(struct input_event) : 0U;
+            for (std::size_t index = 0; index < count; ++index) {
+                const auto &event = events[index];
+                if (event.type == EV_ABS) {
+                    if (event.code == ABS_MT_SLOT) {
+                        currentTouchSlot_ = std::clamp(event.value, 0, static_cast<int>(kMaxTouchSlots - 1U));
+                    } else {
+                        auto &slot = touchSlots_[static_cast<std::size_t>(currentTouchSlot_)];
+                        switch (event.code) {
+                        case ABS_MT_TRACKING_ID: slot.active = event.value >= 0; slot.changed = true; break;
+                        case ABS_MT_POSITION_X: slot.rawX = event.value; slot.changed = true; break;
+                        case ABS_MT_POSITION_Y: slot.rawY = event.value; slot.changed = true; break;
+                        case ABS_MT_TOUCH_MAJOR: slot.touchMajor = event.value; slot.changed = true; break;
+                        case ABS_MT_TOUCH_MINOR: slot.touchMinor = event.value; slot.changed = true; break;
+                        case ABS_MT_PRESSURE: slot.pressure = event.value; slot.changed = true; break;
+                        case ABS_MT_DISTANCE: slot.distance = event.value; slot.changed = true; break;
+                        case ABS_MT_TOOL_TYPE: slot.toolType = event.value; slot.changed = true; break;
+                        default: break;
+                        }
+                    }
+                } else if (event.type == EV_SYN && event.code == SYN_REPORT && touchCallback_) {
+                    TouchFrame frame;
+                    frame.eventTimestampNs = eventTimestampNs(event.time.tv_sec, event.time.tv_usec);
+                    frame.receiptTimestampNs = monotonicNs();
+                    frame.sequence = ++sequence_;
+                    for (std::size_t slotIndex = 0; slotIndex < touchSlots_.size(); ++slotIndex) {
+                        auto &slot = touchSlots_[slotIndex];
+                        if (!slot.changed) continue;
+                        frame.changedContacts.push_back(TouchContact{
+                            static_cast<std::uint8_t>(slotIndex),
+                            slot.active,
+                            normalize(slot.rawX, touchX_),
+                            normalize(slot.rawY, touchY_),
+                            static_cast<std::uint16_t>(std::clamp(slot.touchMajor, 0, 65535)),
+                            static_cast<std::uint16_t>(std::clamp(slot.touchMinor, 0, 65535)),
+                            static_cast<std::uint16_t>(std::clamp(slot.pressure, 0, 65535)),
+                            static_cast<std::uint16_t>(std::clamp(slot.distance, 0, 65535)),
+                            static_cast<std::uint16_t>(std::clamp(slot.toolType, 0, 65535)),
+                        });
+                        slot.changed = false;
+                    }
+                    if (!frame.changedContacts.empty()) touchCallback_(frame);
+                }
+            }
+        }
+    }
+    running_.store(false);
+}
+
+} // namespace nativeink
diff --git a/src/nativeink/NativeInkInput.h b/src/nativeink/NativeInkInput.h
new file mode 100644
index 0000000..88bd20e
--- /dev/null
+++ b/src/nativeink/NativeInkInput.h
@@ -0,0 +1,123 @@
+#pragma once
+
+#include "NativeInkProtocol.h"
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace nativeink {
+
+struct PenSample {
+    float normalizedX = 0.0F;
+    float normalizedY = 0.0F;
+    std::uint64_t eventTimestampNs = 0;
+    std::uint64_t receiptTimestampNs = 0;
+    std::uint64_t sequence = 0;
+    std::uint16_t pressure = 0;
+    std::int16_t tiltX = 0;
+    std::int16_t tiltY = 0;
+    std::uint32_t distance = 0;
+    Tool tool = Tool::None;
+    bool proximity = false;
+    bool contact = false;
+};
+
+struct TouchContact {
+    std::uint8_t slot = 0;
+    bool active = false;
+    float normalizedX = 0.0F;
+    float normalizedY = 0.0F;
+    std::uint16_t touchMajor = 0;
+    std::uint16_t touchMinor = 0;
+    std::uint16_t pressure = 0;
+    std::uint16_t distance = 0;
+    std::uint16_t toolType = 0;
+};
+
+struct TouchFrame {
+    std::uint64_t eventTimestampNs = 0;
+    std::uint64_t receiptTimestampNs = 0;
+    std::uint64_t sequence = 0;
+    std::vector<TouchContact> changedContacts;
+};
+
+class NativeInkInput {
+public:
+    using PenCallback = std::function<void(const PenSample &)>;
+    using TouchCallback = std::function<void(const TouchFrame &)>;
+
+    NativeInkInput();
+    ~NativeInkInput();
+
+    NativeInkInput(const NativeInkInput &) = delete;
+    NativeInkInput &operator=(const NativeInkInput &) = delete;
+
+    bool start(const std::string &penPath, const std::string &touchPath,
+               PenCallback penCallback, TouchCallback touchCallback);
+    void stop();
+    bool running() const { return running_.load(); }
+    std::uint32_t capabilities() const { return capabilities_; }
+    const std::string &lastError() const { return lastError_; }
+
+private:
+    struct AxisRange {
+        int minimum = 0;
+        int maximum = 1;
+        bool available = false;
+    };
+
+    void readerLoop();
+    bool configurePen();
+    bool configureTouch();
+    static AxisRange queryAxis(int fd, unsigned axis);
+    static float normalize(int value, const AxisRange &range);
+    static std::uint64_t eventTimestampNs(long seconds, long microseconds);
+    static std::uint64_t monotonicNs();
+
+    int penFd_ = -1;
+    int touchFd_ = -1;
+    std::atomic<bool> running_{false};
+    std::thread thread_;
+    PenCallback penCallback_;
+    TouchCallback touchCallback_;
+    std::string lastError_;
+    std::uint32_t capabilities_ = 0;
+    std::uint64_t sequence_ = 0;
+
+    AxisRange penX_;
+    AxisRange penY_;
+    AxisRange penPressure_;
+    AxisRange touchX_;
+    AxisRange touchY_;
+
+    int rawPenX_ = 0;
+    int rawPenY_ = 0;
+    int rawPressure_ = 0;
+    int rawTiltX_ = 0;
+    int rawTiltY_ = 0;
+    int rawDistance_ = 0;
+    bool penTool_ = false;
+    bool rubberTool_ = false;
+    bool penContact_ = false;
+
+    struct TouchSlotState {
+        bool active = false;
+        bool changed = false;
+        int rawX = 0;
+        int rawY = 0;
+        int touchMajor = 0;
+        int touchMinor = 0;
+        int pressure = 0;
+        int distance = 0;
+        int toolType = 0;
+    };
+    std::array<TouchSlotState, kMaxTouchSlots> touchSlots_{};
+    int currentTouchSlot_ = 0;
+};
+
+} // namespace nativeink
diff --git a/src/nativeink/NativeInkIpcServer.cpp b/src/nativeink/NativeInkIpcServer.cpp
new file mode 100644
index 0000000..3bbf0b8
--- /dev/null
+++ b/src/nativeink/NativeInkIpcServer.cpp
@@ -0,0 +1,180 @@
+#include "NativeInkIpcServer.h"
+
+#include <cerrno>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace nativeink {
+
+namespace {
+
+#ifndef MSG_NOSIGNAL
+#define MSG_NOSIGNAL 0
+#endif
+
+int socketFlags()
+{
+    int flags = SOCK_SEQPACKET;
+#ifdef SOCK_NONBLOCK
+    flags |= SOCK_NONBLOCK;
+#endif
+#ifdef SOCK_CLOEXEC
+    flags |= SOCK_CLOEXEC;
+#endif
+    return flags;
+}
+
+void makeNonBlockingAndCloseOnExec(int fd)
+{
+    const int statusFlags = ::fcntl(fd, F_GETFL, 0);
+    if (statusFlags >= 0) ::fcntl(fd, F_SETFL, statusFlags | O_NONBLOCK);
+    const int descriptorFlags = ::fcntl(fd, F_GETFD, 0);
+    if (descriptorFlags >= 0) ::fcntl(fd, F_SETFD, descriptorFlags | FD_CLOEXEC);
+}
+
+} // namespace
+
+NativeInkIpcServer::NativeInkIpcServer() = default;
+
+NativeInkIpcServer::~NativeInkIpcServer()
+{
+    stop();
+}
+
+bool NativeInkIpcServer::start(int framebufferId)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (listenFd_ >= 0) return true;
+    if (framebufferId < 0) {
+        lastError_ = "invalid_framebuffer_id";
+        return false;
+    }
+    socketPath_ = "/tmp/appload-native-ink-" + std::to_string(framebufferId) + ".sock";
+    struct sockaddr_un address {};
+    if (socketPath_.size() >= sizeof(address.sun_path)) {
+        lastError_ = "socket_path_too_long";
+        return false;
+    }
+
+    listenFd_ = ::socket(AF_UNIX, socketFlags(), 0);
+    if (listenFd_ < 0) {
+        lastError_ = "socket_failed:" + std::to_string(errno);
+        return false;
+    }
+    makeNonBlockingAndCloseOnExec(listenFd_);
+
+    address.sun_family = AF_UNIX;
+    std::memcpy(address.sun_path, socketPath_.c_str(), socketPath_.size() + 1U);
+    ::unlink(socketPath_.c_str());
+    if (::bind(listenFd_, reinterpret_cast<const struct sockaddr *>(&address), sizeof(address)) < 0) {
+        lastError_ = "bind_failed:" + std::to_string(errno);
+        ::close(listenFd_);
+        listenFd_ = -1;
+        return false;
+    }
+    ::chmod(socketPath_.c_str(), S_IRUSR | S_IWUSR);
+    if (::listen(listenFd_, 1) < 0) {
+        lastError_ = "listen_failed:" + std::to_string(errno);
+        ::close(listenFd_);
+        listenFd_ = -1;
+        ::unlink(socketPath_.c_str());
+        return false;
+    }
+    lastError_.clear();
+    return true;
+}
+
+void NativeInkIpcServer::closeClient()
+{
+    if (clientFd_ >= 0) ::close(clientFd_);
+    clientFd_ = -1;
+}
+
+void NativeInkIpcServer::stop()
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    closeClient();
+    if (listenFd_ >= 0) ::close(listenFd_);
+    listenFd_ = -1;
+    if (!socketPath_.empty()) ::unlink(socketPath_.c_str());
+    socketPath_.clear();
+}
+
+bool NativeInkIpcServer::acceptClient()
+{
+    if (clientFd_ >= 0) return true;
+    if (listenFd_ < 0) return false;
+    clientFd_ = ::accept(listenFd_, nullptr, nullptr);
+    if (clientFd_ < 0) {
+        if (errno != EAGAIN && errno != EWOULDBLOCK)
+            lastError_ = "accept_failed:" + std::to_string(errno);
+        return false;
+    }
+    makeNonBlockingAndCloseOnExec(clientFd_);
+#ifdef SO_PEERCRED
+    struct PeerCredentials {
+        pid_t pid;
+        uid_t uid;
+        gid_t gid;
+    } credentials {};
+    socklen_t credentialBytes = sizeof(credentials);
+    if (::getsockopt(clientFd_, SOL_SOCKET, SO_PEERCRED, &credentials, &credentialBytes) < 0
+        || credentials.uid != ::geteuid()) {
+        lastError_ = "peer_credential_rejected";
+        closeClient();
+        return false;
+    }
+#endif
+    return true;
+}
+
+bool NativeInkIpcServer::send(MessageType type, std::uint64_t sequence,
+                              std::uint64_t timestampNs, std::uint64_t strokeId,
+                              std::uint32_t flags, const void *payload,
+                              std::uint32_t payloadBytes, std::uint32_t pointCount)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    Header header;
+    header.messageType = static_cast<std::uint16_t>(type);
+    header.payloadBytes = payloadBytes;
+    header.sequence = sequence;
+    header.timestampNs = timestampNs;
+    header.strokeId = strokeId;
+    header.flags = flags;
+    header.pointCount = pointCount;
+    if (!validateHeader(header) || (payloadBytes > 0U && payload == nullptr)) {
+        lastError_ = "invalid_packet";
+        packetsDropped_++;
+        return false;
+    }
+    if (!acceptClient()) {
+        packetsDropped_++;
+        return false;
+    }
+
+    struct iovec vectors[2] = {
+        {&header, sizeof(header)},
+        {const_cast<void *>(payload), payloadBytes},
+    };
+    struct msghdr message {};
+    message.msg_iov = vectors;
+    message.msg_iovlen = payloadBytes > 0U ? 2U : 1U;
+    const ssize_t sent = ::sendmsg(clientFd_, &message, MSG_DONTWAIT | MSG_NOSIGNAL);
+    if (sent != static_cast<ssize_t>(sizeof(header) + payloadBytes)) {
+        packetsDropped_++;
+        if (sent < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+            lastError_ = "send_failed:" + std::to_string(errno);
+            closeClient();
+        }
+        return false;
+    }
+    packetsSent_++;
+    return true;
+}
+
+} // namespace nativeink
