@@ -0,0 +1,31 @@
+#include "../src/qtfb/ScaledRect.h"
+
+#include <cassert>
+#include <iostream>
+
+int main()
+{
+    using qtfb::scale::Rect;
+    using qtfb::scale::fromFramebuffer;
+
+    const Rect onePixel = fromFramebuffer({100, 200, 1, 1}, 1620, 2160, 810, 1080);
+    assert(onePixel.valid());
+    assert(onePixel.x == 50);
+    assert(onePixel.y == 100);
+    assert(onePixel.width == 1);
+    assert(onePixel.height == 1);
+
+    const Rect dirty = fromFramebuffer({810, 1080, 100, 200}, 1620, 2160, 1620, 2160);
+    assert(dirty.x == 810 && dirty.y == 1080);
+    assert(dirty.width == 100 && dirty.height == 200);
+
+    const Rect scaledUp = fromFramebuffer({10, 20, 30, 40}, 100, 200, 200, 400);
+    assert(scaledUp.x == 20 && scaledUp.y == 40);
+    assert(scaledUp.width == 60 && scaledUp.height == 80);
+
+    assert(!fromFramebuffer({}, 1620, 2160, 1620, 2160).valid());
+    assert(!fromFramebuffer({1, 1, 1, 1}, 0, 2160, 1620, 2160).valid());
+
+    std::cout << "qtfb_scaled_rect_test: PASS\n";
+    return 0;
+}
