@@ -0,0 +1,494 @@
+#include "NativeInkOverlay.h"
+
+#include <QFile>
+#include <QMetaObject>
+#include <QPainter>
+#include <QPen>
+#include <QRectF>
+#include <QVector>
+#include <QtGlobal>
+
+#include <algorithm>
+#include <cmath>
+#include <time.h>
+#include <utility>
+
+namespace {
+
+QRectF toQRect(const nativeink::RectF &rect)
+{
+    return QRectF(rect.x, rect.y, rect.width, rect.height);
+}
+
+} // namespace
+
+NativeInkOverlay::NativeInkOverlay(QQuickItem *parent)
+    : QQuickPaintedItem(parent)
+{
+    setRenderTarget(QQuickPaintedItem::Image);
+    setOpaquePainting(false);
+    setFillColor(Qt::transparent);
+    setAntialiasing(false);
+    setMipmap(false);
+    setAcceptedMouseButtons(Qt::NoButton);
+    setAcceptTouchEvents(false);
+}
+
+NativeInkOverlay::~NativeInkOverlay()
+{
+    stopSession();
+}
+
+void NativeInkOverlay::setSessionEnabled(bool enabled)
+{
+    if (sessionEnabled_ == enabled) return;
+    sessionEnabled_ = enabled;
+    if (sessionEnabled_) startSession(); else stopSession();
+    emit sessionEnabledChanged();
+}
+
+void NativeInkOverlay::setFramebufferID(int framebufferID)
+{
+    if (framebufferID_ == framebufferID) return;
+    const bool restart = sessionEnabled_;
+    if (restart) stopSession();
+    framebufferID_ = framebufferID;
+    if (restart) startSession();
+    emit framebufferIDChanged();
+}
+
+void NativeInkOverlay::clearPreview()
+{
+    if (contactDown_) return;
+    nativeink::RectF dirty;
+    for (const auto &stroke : completedStrokes_)
+        dirty = nativeink::unite(dirty, nativeink::strokeBounds(pointVector(stroke), kPenWidth * 0.5F));
+    if (!activeStroke_.points.empty())
+        dirty = nativeink::unite(dirty, nativeink::strokeBounds(pointVector(activeStroke_), kPenWidth * 0.5F));
+    completedStrokes_.clear();
+    activeStroke_ = {};
+    pendingPoints_.clear();
+    contactDown_ = false;
+    activeTool_ = nativeink::Tool::None;
+    activeStrokeID_ = 0;
+    if (dirty.valid()) update(toQRect(dirty).intersected(boundingRect()).toAlignedRect());
+}
+
+void NativeInkOverlay::startSession()
+{
+    if (!sessionEnabled_ || framebufferID_ < 0 || input_.running()) return;
+    QFile machine(QStringLiteral("/sys/devices/soc0/machine"));
+    if (!machine.open(QIODevice::ReadOnly)
+        || !machine.readAll().contains("reMarkable Ferrari")) {
+        startupError_ = QStringLiteral("unsupported_model");
+        sessionActive_ = false;
+        emit sessionActiveChanged();
+        emit diagnosticsChanged();
+        return;
+    }
+    startupError_.clear();
+    if (!ipc_.start(framebufferID_)) {
+        startupError_ = QString::fromStdString(ipc_.lastError());
+        sessionActive_ = false;
+        emit sessionActiveChanged();
+        emit diagnosticsChanged();
+        return;
+    }
+    const bool started = input_.start(
+        "/dev/input/event2", "/dev/input/event3",
+        [this](const nativeink::PenSample &sample) { enqueuePen(sample); },
+        [this](const nativeink::TouchFrame &frame) { enqueueTouch(frame); });
+    if (!started) {
+        startupError_ = QString::fromStdString(input_.lastError());
+        sessionActive_ = false;
+        ipc_.stop();
+    } else {
+        sessionActive_ = true;
+    }
+    emit sessionActiveChanged();
+    emit diagnosticsChanged();
+}
+
+void NativeInkOverlay::stopSession()
+{
+    if (input_.running()) input_.stop();
+    nativeink::PenSample finalSample;
+    finalSample.eventTimestampNs = monotonicNs();
+    if (contactDown_) finishContact(finalSample);
+    const auto metrics = metricsSnapshot();
+    ipc_.send(nativeink::MessageType::Metrics, ++messageSequence_, monotonicNs(), 0, 0,
+              &metrics, sizeof(metrics));
+    ipc_.send(nativeink::MessageType::Goodbye, ++messageSequence_, monotonicNs(), 0, 0);
+    ipc_.stop();
+    {
+        std::lock_guard<std::mutex> lock(queueMutex_);
+        eventQueue_.clear();
+    }
+    drainScheduled_.store(false);
+    markerInProximity_ = false;
+    rearEraserSelected_ = false;
+    contactDown_ = false;
+    activeTool_ = nativeink::Tool::None;
+    eraserCursorVisible_ = false;
+    if (sessionActive_) {
+        sessionActive_ = false;
+        emit sessionActiveChanged();
+    }
+    emit markerInProximityChanged();
+    emit rearEraserSelectedChanged();
+    emit diagnosticsChanged();
+}
+
+void NativeInkOverlay::enqueuePen(const nativeink::PenSample &sample)
+{
+    rawSamplesReceived_.fetch_add(1U);
+    QueuedEvent event;
+    event.kind = QueuedEvent::Kind::Pen;
+    event.pen = sample;
+    enqueue(std::move(event));
+}
+
+void NativeInkOverlay::enqueueTouch(const nativeink::TouchFrame &frame)
+{
+    rawSamplesReceived_.fetch_add(1U);
+    QueuedEvent event;
+    event.kind = QueuedEvent::Kind::Touch;
+    event.touch = frame;
+    enqueue(std::move(event));
+}
+
+void NativeInkOverlay::enqueue(QueuedEvent event)
+{
+    {
+        std::lock_guard<std::mutex> lock(queueMutex_);
+        if (eventQueue_.size() >= kMaxQueuedEvents) {
+            eventQueue_.pop_front();
+            samplesDropped_.fetch_add(1U);
+        }
+        eventQueue_.push_back(std::move(event));
+    }
+    if (drainScheduled_.exchange(true)) {
+        displayUpdatesCoalesced_.fetch_add(1U);
+        return;
+    }
+    QMetaObject::invokeMethod(this, [this]() { drainEvents(); }, Qt::QueuedConnection);
+}
+
+void NativeInkOverlay::drainEvents()
+{
+    std::deque<QueuedEvent> pending;
+    {
+        std::lock_guard<std::mutex> lock(queueMutex_);
+        pending.swap(eventQueue_);
+    }
+
+    nativeink::RectF dirty;
+    std::uint64_t newestEventTimestamp = 0;
+    std::uint64_t newestReceiptTimestamp = 0;
+    for (const auto &event : pending) {
+        if (event.kind == QueuedEvent::Kind::Pen) {
+            dirty = nativeink::unite(dirty, processPen(event.pen));
+            newestEventTimestamp = std::max(newestEventTimestamp, event.pen.eventTimestampNs);
+            newestReceiptTimestamp = std::max(newestReceiptTimestamp, event.pen.receiptTimestampNs);
+            if (event.pen.receiptTimestampNs >= event.pen.eventTimestampNs
+                && event.pen.receiptTimestampNs - event.pen.eventTimestampNs <= UINT64_C(10000000000)) {
+                rawToReceiptUs_.fetch_add(
+                    (event.pen.receiptTimestampNs - event.pen.eventTimestampNs) / 1000U);
+                rawToReceiptCount_.fetch_add(1U);
+            }
+        } else {
+            processTouch(event.touch);
+        }
+    }
+
+    if (dirty.valid()) {
+        const QRectF clipped = toQRect(dirty).intersected(boundingRect());
+        if (clipped.isValid() && !clipped.isEmpty()) {
+            update(clipped.toAlignedRect());
+            displayUpdatesSubmitted_.fetch_add(1U);
+            const std::uint64_t submittedAt = monotonicNs();
+            if (newestReceiptTimestamp > 0 && submittedAt >= newestReceiptTimestamp) {
+                receiptToSubmitUs_.fetch_add((submittedAt - newestReceiptTimestamp) / 1000U);
+                receiptToSubmitCount_.fetch_add(1U);
+            }
+            if (newestEventTimestamp > 0 && submittedAt >= newestEventTimestamp
+                && submittedAt - newestEventTimestamp <= UINT64_C(10000000000)) {
+                eventToSubmitUs_.fetch_add((submittedAt - newestEventTimestamp) / 1000U);
+                eventToSubmitCount_.fetch_add(1U);
+            }
+        }
+    }
+
+    drainScheduled_.store(false);
+    {
+        std::lock_guard<std::mutex> lock(queueMutex_);
+        if (!eventQueue_.empty() && !drainScheduled_.exchange(true))
+            QMetaObject::invokeMethod(this, [this]() { drainEvents(); }, Qt::QueuedConnection);
+    }
+    emit diagnosticsChanged();
+}
+
+nativeink::RectF NativeInkOverlay::processPen(const nativeink::PenSample &sample)
+{
+    nativeink::RectF dirty;
+    const bool proximityChanged = markerInProximity_ != sample.proximity;
+    const bool eraserChanged = rearEraserSelected_ != (sample.tool == nativeink::Tool::RearEraser);
+    markerInProximity_ = sample.proximity;
+    rearEraserSelected_ = sample.tool == nativeink::Tool::RearEraser;
+    if (proximityChanged) emit markerInProximityChanged();
+    if (eraserChanged) emit rearEraserSelectedChanged();
+
+    if (eraserCursorVisible_) dirty = nativeink::unite(dirty, eraserCursorBounds());
+    eraserCursor_ = {sample.normalizedX * static_cast<float>(width()),
+                     sample.normalizedY * static_cast<float>(height())};
+    eraserCursorVisible_ = sample.proximity && sample.tool == nativeink::Tool::RearEraser;
+    if (eraserCursorVisible_) dirty = nativeink::unite(dirty, eraserCursorBounds());
+
+    if (sample.contact) {
+        if (!contactDown_ || activeTool_ != sample.tool) {
+            if (contactDown_) dirty = nativeink::unite(dirty, finishContact(sample));
+            dirty = nativeink::unite(dirty, beginContact(sample));
+        }
+        dirty = nativeink::unite(dirty, appendContactPoint(sample));
+    } else if (contactDown_) {
+        dirty = nativeink::unite(dirty, finishContact(sample));
+    }
+    return dirty;
+}
+
+void NativeInkOverlay::processTouch(const nativeink::TouchFrame &frame)
+{
+    Q_UNUSED(frame)
+    // Touch geometry is intentionally retained only in memory. AppLoad's
+    // FBController forwards normal finger gestures while Marker proximity is
+    // false and suppresses the whole touch path while proximity is true.
+}
+
+nativeink::RectF NativeInkOverlay::beginContact(const nativeink::PenSample &sample)
+{
+    contactDown_ = true;
+    activeTool_ = sample.tool;
+    activeStrokeID_ = ++nextStrokeID_;
+    pendingPoints_.clear();
+    activeStroke_ = Stroke{activeStrokeID_, {}};
+    sendHello(sample.eventTimestampNs);
+    const auto type = activeTool_ == nativeink::Tool::RearEraser
+        ? nativeink::MessageType::EraseBegin : nativeink::MessageType::StrokeBegin;
+    ipc_.send(type, ++messageSequence_, sample.eventTimestampNs, activeStrokeID_,
+              toolFlags(activeTool_, nativeink::FlagContact | nativeink::FlagProximity));
+    return {};
+}
+
+nativeink::RectF NativeInkOverlay::appendContactPoint(const nativeink::PenSample &sample)
+{
+    nativeink::Point point;
+    point.x = sample.normalizedX * static_cast<float>(width());
+    point.y = sample.normalizedY * static_cast<float>(height());
+    point.timestampNs = sample.eventTimestampNs;
+    point.pressure = sample.pressure;
+    point.tiltX = sample.tiltX;
+    point.tiltY = sample.tiltY;
+    point.tool = static_cast<std::uint16_t>(sample.tool);
+
+    nativeink::RectF dirty;
+    if (activeTool_ == nativeink::Tool::Pen) {
+        const nativeink::PointF current = pointF(point);
+        const nativeink::PointF previous = activeStroke_.points.empty()
+            ? current : pointF(activeStroke_.points.back());
+        const float dx = current.x - previous.x;
+        const float dy = current.y - previous.y;
+        if (!activeStroke_.points.empty() && dx * dx + dy * dy < 0.25F)
+            return {};
+        activeStroke_.points.push_back(point);
+        dirty = nativeink::segmentBounds(previous, current, kPenWidth * 0.5F);
+    } else if (activeTool_ == nativeink::Tool::RearEraser) {
+        dirty = eraseAt(point);
+    }
+
+    pendingPoints_.push_back(point);
+    samplesRendered_.fetch_add(1U);
+    if (pendingPoints_.size() >= 64U) flushPointBatch(false);
+    return dirty;
+}
+
+nativeink::RectF NativeInkOverlay::finishContact(const nativeink::PenSample &sample)
+{
+    if (!contactDown_) return {};
+    flushPointBatch(true);
+    const auto type = activeTool_ == nativeink::Tool::RearEraser
+        ? nativeink::MessageType::EraseEnd : nativeink::MessageType::StrokeEnd;
+    ipc_.send(type, ++messageSequence_, sample.eventTimestampNs, activeStrokeID_,
+              toolFlags(activeTool_, nativeink::FlagFinalChunk));
+    const auto metrics = metricsSnapshot();
+    ipc_.send(nativeink::MessageType::Metrics, ++messageSequence_, sample.eventTimestampNs,
+              activeStrokeID_, 0, &metrics, sizeof(metrics));
+    nativeink::RectF dirty;
+    if (activeTool_ == nativeink::Tool::Pen && !activeStroke_.points.empty()) {
+        dirty = nativeink::strokeBounds(pointVector(activeStroke_), kPenWidth * 0.5F);
+        completedStrokes_.push_back(std::move(activeStroke_));
+    }
+    activeStroke_ = {};
+    pendingPoints_.clear();
+    contactDown_ = false;
+    activeTool_ = nativeink::Tool::None;
+    activeStrokeID_ = 0;
+    return dirty;
+}
+
+nativeink::RectF NativeInkOverlay::eraseAt(const nativeink::Point &point)
+{
+    nativeink::RectF dirty;
+    const nativeink::PointF target = pointF(point);
+    for (auto iterator = completedStrokes_.begin(); iterator != completedStrokes_.end();) {
+        const auto points = pointVector(*iterator);
+        if (nativeink::strokeHit(points, target, kEraserRadius)) {
+            dirty = nativeink::unite(dirty, nativeink::strokeBounds(points, kPenWidth * 0.5F));
+            iterator = completedStrokes_.erase(iterator);
+        } else {
+            ++iterator;
+        }
+    }
+    return nativeink::unite(dirty, eraserCursorBounds());
+}
+
+nativeink::RectF NativeInkOverlay::eraserCursorBounds() const
+{
+    if (!eraserCursorVisible_) return {};
+    return nativeink::segmentBounds(eraserCursor_, eraserCursor_, kEraserRadius, 3.0F);
+}
+
+void NativeInkOverlay::sendHello(std::uint64_t timestampNs)
+{
+    nativeink::Hello hello;
+    hello.screenWidth = static_cast<std::uint32_t>(std::max(0.0, width()));
+    hello.screenHeight = static_cast<std::uint32_t>(std::max(0.0, height()));
+    hello.capabilities = input_.capabilities();
+    ipc_.send(nativeink::MessageType::Hello, ++messageSequence_, timestampNs, 0,
+              0, &hello, sizeof(hello));
+}
+
+void NativeInkOverlay::flushPointBatch(bool finalChunk)
+{
+    if (pendingPoints_.empty()) return;
+    std::size_t offset = 0;
+    while (offset < pendingPoints_.size()) {
+        const std::size_t count = std::min<std::size_t>(nativeink::kMaxPointsPerPacket,
+                                                        pendingPoints_.size() - offset);
+        const bool finalPacket = finalChunk && offset + count == pendingPoints_.size();
+        const auto type = activeTool_ == nativeink::Tool::RearEraser
+            ? nativeink::MessageType::ErasePoints : nativeink::MessageType::StrokePoints;
+        const bool sent = ipc_.send(type, ++messageSequence_,
+            pendingPoints_[offset + count - 1U].timestampNs, activeStrokeID_,
+            toolFlags(activeTool_, finalPacket ? nativeink::FlagFinalChunk : 0U),
+            pendingPoints_.data() + offset,
+            static_cast<std::uint32_t>(count * sizeof(nativeink::Point)),
+            static_cast<std::uint32_t>(count));
+        if (sent) samplesHandedToClient_.fetch_add(count);
+        else samplesDropped_.fetch_add(count);
+        offset += count;
+    }
+    pendingPoints_.clear();
+}
+
+void NativeInkOverlay::paint(QPainter *painter)
+{
+    const std::uint64_t startedAt = monotonicNs();
+    painter->setRenderHint(QPainter::Antialiasing, false);
+    QPen pen(Qt::black);
+    pen.setWidthF(kPenWidth);
+    pen.setCapStyle(Qt::RoundCap);
+    pen.setJoinStyle(Qt::RoundJoin);
+    painter->setPen(pen);
+
+    auto paintStroke = [painter](const Stroke &stroke) {
+        if (stroke.points.empty()) return;
+        if (stroke.points.size() == 1U) {
+            const auto &point = stroke.points.front();
+            painter->drawPoint(QPointF(point.x, point.y));
+            return;
+        }
+        for (std::size_t index = 1; index < stroke.points.size(); ++index) {
+            const auto &left = stroke.points[index - 1U];
+            const auto &right = stroke.points[index];
+            painter->drawLine(QPointF(left.x, left.y), QPointF(right.x, right.y));
+        }
+    };
+    for (const auto &stroke : completedStrokes_) paintStroke(stroke);
+    if (contactDown_ && activeTool_ == nativeink::Tool::Pen) paintStroke(activeStroke_);
+    if (eraserCursorVisible_) {
+        QPen cursorPen(Qt::black);
+        cursorPen.setWidthF(2.0F);
+        painter->setPen(cursorPen);
+        painter->setBrush(Qt::NoBrush);
+        painter->drawEllipse(QPointF(eraserCursor_.x, eraserCursor_.y),
+                             kEraserRadius, kEraserRadius);
+    }
+
+    paintCalls_.fetch_add(1U);
+    const std::uint64_t finishedAt = monotonicNs();
+    if (finishedAt >= startedAt) paintTimeUs_.fetch_add((finishedAt - startedAt) / 1000U);
+}
+
+nativeink::Metrics NativeInkOverlay::metricsSnapshot() const
+{
+    nativeink::Metrics metrics;
+    metrics.rawSamplesReceived = rawSamplesReceived_.load();
+    metrics.samplesRendered = samplesRendered_.load();
+    metrics.samplesHandedToClient = samplesHandedToClient_.load();
+    metrics.samplesDropped = samplesDropped_.load();
+    metrics.displayUpdatesSubmitted = displayUpdatesSubmitted_.load();
+    metrics.displayUpdatesCoalesced = displayUpdatesCoalesced_.load();
+    metrics.paintCalls = paintCalls_.load();
+    metrics.paintTimeUs = paintTimeUs_.load();
+    metrics.rawToReceiptUs = rawToReceiptUs_.load();
+    metrics.rawToReceiptCount = rawToReceiptCount_.load();
+    metrics.receiptToSubmitUs = receiptToSubmitUs_.load();
+    metrics.receiptToSubmitCount = receiptToSubmitCount_.load();
+    metrics.eventToSubmitUs = eventToSubmitUs_.load();
+    metrics.eventToSubmitCount = eventToSubmitCount_.load();
+    return metrics;
+}
+
+QString NativeInkOverlay::diagnosticsSummary() const
+{
+    const auto metrics = metricsSnapshot();
+    const double meanPaintUs = metrics.paintCalls > 0
+        ? static_cast<double>(metrics.paintTimeUs) / static_cast<double>(metrics.paintCalls) : 0.0;
+    const double meanEventToSubmitUs = metrics.eventToSubmitCount > 0
+        ? static_cast<double>(metrics.eventToSubmitUs) / static_cast<double>(metrics.eventToSubmitCount) : 0.0;
+    const double meanReceiptToSubmitUs = metrics.receiptToSubmitCount > 0
+        ? static_cast<double>(metrics.receiptToSubmitUs) / static_cast<double>(metrics.receiptToSubmitCount) : 0.0;
+    return QStringLiteral("error=%1 raw=%2 rendered=%3 ipc=%4 dropped=%5 updates=%6 coalesced=%7 paint_mean_us=%8 receipt_to_submit_mean_us=%9 event_to_submit_mean_us=%10")
+        .arg(startupError_.isEmpty() ? QStringLiteral("none") : startupError_)
+        .arg(metrics.rawSamplesReceived).arg(metrics.samplesRendered)
+        .arg(metrics.samplesHandedToClient).arg(metrics.samplesDropped)
+        .arg(metrics.displayUpdatesSubmitted).arg(metrics.displayUpdatesCoalesced)
+        .arg(meanPaintUs, 0, 'f', 1).arg(meanReceiptToSubmitUs, 0, 'f', 1)
+        .arg(meanEventToSubmitUs, 0, 'f', 1);
+}
+
+std::uint64_t NativeInkOverlay::monotonicNs()
+{
+    struct timespec now {};
+    if (::clock_gettime(CLOCK_MONOTONIC, &now) != 0) return 0;
+    return static_cast<std::uint64_t>(now.tv_sec) * UINT64_C(1000000000)
+        + static_cast<std::uint64_t>(now.tv_nsec);
+}
+
+std::uint32_t NativeInkOverlay::toolFlags(nativeink::Tool tool, std::uint32_t flags)
+{
+    return flags | (static_cast<std::uint32_t>(tool) << 16U);
+}
+
+nativeink::PointF NativeInkOverlay::pointF(const nativeink::Point &point)
+{
+    return {point.x, point.y};
+}
+
+std::vector<nativeink::PointF> NativeInkOverlay::pointVector(const Stroke &stroke)
+{
+    std::vector<nativeink::PointF> result;
+    result.reserve(stroke.points.size());
+    for (const auto &point : stroke.points) result.push_back(pointF(point));
+    return result;
+}
