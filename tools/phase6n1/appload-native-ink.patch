@@ -0,0 +1,47 @@
+#pragma once
+
+#include "NativeInkProtocol.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <string>
+
+namespace nativeink {
+
+class NativeInkIpcServer {
+public:
+    NativeInkIpcServer();
+    ~NativeInkIpcServer();
+
+    NativeInkIpcServer(const NativeInkIpcServer &) = delete;
+    NativeInkIpcServer &operator=(const NativeInkIpcServer &) = delete;
+
+    bool start(int framebufferId);
+    void stop();
+    bool send(MessageType type, std::uint64_t sequence, std::uint64_t timestampNs,
+              std::uint64_t strokeId, std::uint32_t flags,
+              const void *payload = nullptr, std::uint32_t payloadBytes = 0,
+              std::uint32_t pointCount = 0);
+
+    bool listening() const { return listenFd_ >= 0; }
+    bool connected() const { return clientFd_ >= 0; }
+    const std::string &socketPath() const { return socketPath_; }
+    const std::string &lastError() const { return lastError_; }
+    std::uint64_t packetsSent() const { return packetsSent_; }
+    std::uint64_t packetsDropped() const { return packetsDropped_; }
+
+private:
+    bool acceptClient();
+    void closeClient();
+
+    int listenFd_ = -1;
+    int clientFd_ = -1;
+    std::string socketPath_;
+    std::string lastError_;
+    mutable std::mutex mutex_;
+    std::uint64_t packetsSent_ = 0;
+    std::uint64_t packetsDropped_ = 0;
+};
+
+} // namespace nativeink
diff --git a/src/nativeink/NativeInkOverlay.cpp b/src/nativeink/NativeInkOverlay.cpp
