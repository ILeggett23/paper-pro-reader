diff --git a/src/qtfb/ScaledRect.h b/src/qtfb/ScaledRect.h
new file mode 100644
index 0000000..92881a5
--- /dev/null
+++ b/src/qtfb/ScaledRect.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace qtfb::scale {
+
+struct Rect {
+    int x = 0;
+    int y = 0;
+    int width = 0;
+    int height = 0;
+
+    bool valid() const { return width > 0 && height > 0; }
+};
+
+inline Rect fromFramebuffer(const Rect &input, int framebufferWidth, int framebufferHeight,
+                            int viewWidth, int viewHeight)
+{
+    if (!input.valid() || framebufferWidth <= 0 || framebufferHeight <= 0
+        || viewWidth <= 0 || viewHeight <= 0)
+        return {};
+    return {
+        static_cast<int>(static_cast<std::int64_t>(input.x) * viewWidth / framebufferWidth),
+        static_cast<int>(static_cast<std::int64_t>(input.y) * viewHeight / framebufferHeight),
+        std::max(1, static_cast<int>((static_cast<std::int64_t>(input.width) * viewWidth
+                                     + framebufferWidth - 1) / framebufferWidth)),
+        std::max(1, static_cast<int>((static_cast<std::int64_t>(input.height) * viewHeight
+                                     + framebufferHeight - 1) / framebufferHeight)),
+    };
+}
+
+} // namespace qtfb::scale
diff --git a/tests/nativeink_geometry_test.cpp b/tests/nativeink_geometry_test.cpp
new file mode 100644
index 0000000..3abb336
--- /dev/null
+++ b/tests/nativeink_geometry_test.cpp
@@ -0,0 +1,38 @@
+#include "../src/nativeink/NativeInkGeometry.h"
+
+#include <cassert>
+#include <cmath>
+#include <iostream>
+#include <vector>
+
+namespace {
+
+bool near(float left, float right)
+{
+    return std::fabs(left - right) < 0.001F;
+}
+
+} // namespace
+
+int main()
+{
+    using namespace nativeink;
+
+    const RectF bounds = segmentBounds({10.0F, 20.0F}, {30.0F, 40.0F}, 2.0F, 1.0F);
+    assert(near(bounds.x, 7.0F));
+    assert(near(bounds.y, 17.0F));
+    assert(near(bounds.width, 26.0F));
+    assert(near(bounds.height, 26.0F));
+
+    const RectF combined = unite({0.0F, 0.0F, 10.0F, 10.0F}, {8.0F, 8.0F, 10.0F, 10.0F});
+    assert(near(combined.width, 18.0F));
+    assert(near(combined.height, 18.0F));
+
+    const std::vector<PointF> stroke{{0.0F, 0.0F}, {100.0F, 0.0F}, {100.0F, 100.0F}};
+    assert(strokeHit(stroke, {50.0F, 4.0F}, 5.0F));
+    assert(strokeHit(stroke, {96.0F, 50.0F}, 5.0F));
+    assert(!strokeHit(stroke, {50.0F, 20.0F}, 5.0F));
+
+    std::cout << "nativeink_geometry_test: PASS\n";
+    return 0;
+}
diff --git a/tests/nativeink_ipc_test.cpp b/tests/nativeink_ipc_test.cpp
new file mode 100644
index 0000000..4716eaf
--- /dev/null
+++ b/tests/nativeink_ipc_test.cpp
@@ -0,0 +1,50 @@
+#include "../src/nativeink/NativeInkIpcServer.h"
+
+#include <cassert>
+#include <cstring>
+#include <iostream>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+int main()
+{
+    using namespace nativeink;
+
+    NativeInkIpcServer server;
+    if (!server.start(654321)) {
+        std::cerr << "nativeink_ipc_test: SKIP " << server.lastError() << "\n";
+        return 77;
+    }
+
+    const int client = ::socket(AF_UNIX, SOCK_SEQPACKET, 0);
+    assert(client >= 0);
+    struct sockaddr_un address {};
+    address.sun_family = AF_UNIX;
+    assert(server.socketPath().size() < sizeof(address.sun_path));
+    std::memcpy(address.sun_path, server.socketPath().c_str(), server.socketPath().size() + 1U);
+    assert(::connect(client, reinterpret_cast<const struct sockaddr *>(&address), sizeof(address)) == 0);
+
+    Hello hello;
+    hello.screenWidth = 1620;
+    hello.screenHeight = 2160;
+    assert(server.send(MessageType::Hello, 1, 1000, 0, 0, &hello, sizeof(hello)));
+
+    unsigned char packet[sizeof(Header) + sizeof(Hello)] {};
+    const ssize_t received = ::recv(client, packet, sizeof(packet), 0);
+    assert(received == static_cast<ssize_t>(sizeof(packet)));
+    const auto *header = reinterpret_cast<const Header *>(packet);
+    assert(validateHeader(*header));
+    assert(header->messageType == static_cast<std::uint16_t>(MessageType::Hello));
+    const auto *payload = reinterpret_cast<const Hello *>(packet + sizeof(Header));
+    assert(payload->screenWidth == 1620);
+    assert(payload->screenHeight == 2160);
+
+    ::close(client);
+    const std::string socketPath = server.socketPath();
+    server.stop();
+    assert(::access(socketPath.c_str(), F_OK) != 0);
+
+    std::cout << "nativeink_ipc_test: PASS\n";
+    return 0;
+}
diff --git a/tests/nativeink_protocol_test.cpp b/tests/nativeink_protocol_test.cpp
new file mode 100644
index 0000000..ebf39b0
--- /dev/null
+++ b/tests/nativeink_protocol_test.cpp
@@ -0,0 +1,45 @@
+#include "../src/nativeink/NativeInkProtocol.h"
+
+#include <cassert>
+#include <cstdint>
+#include <iostream>
+
+int main()
+{
+    using namespace nativeink;
+
+    Header hello;
+    hello.messageType = static_cast<std::uint16_t>(MessageType::Hello);
+    hello.payloadBytes = sizeof(Hello);
+    assert(validateHeader(hello));
+    assert(packetBytes(hello) == sizeof(Header) + sizeof(Hello));
+
+    Header points;
+    points.messageType = static_cast<std::uint16_t>(MessageType::StrokePoints);
+    points.pointCount = 12;
+    points.payloadBytes = points.pointCount * sizeof(Point);
+    assert(validateHeader(points));
+
+    points.payloadBytes--;
+    assert(!validateHeader(points));
+    points.payloadBytes++;
+    points.pointCount = kMaxPointsPerPacket + 1U;
+    assert(!validateHeader(points));
+
+    Header unknown;
+    unknown.messageType = 999;
+    assert(!validateHeader(unknown));
+
+    Header wrongVersion;
+    wrongVersion.messageType = static_cast<std::uint16_t>(MessageType::Goodbye);
+    wrongVersion.protocolMajor++;
+    assert(!validateHeader(wrongVersion));
+
+    Header oversized;
+    oversized.messageType = static_cast<std::uint16_t>(MessageType::Metrics);
+    oversized.payloadBytes = kMaxPayloadBytes + 1U;
+    assert(!validateHeader(oversized));
+
+    std::cout << "nativeink_protocol_test: PASS\n";
+    return 0;
+}
