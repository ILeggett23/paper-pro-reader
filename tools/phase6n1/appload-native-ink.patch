@@ -0,0 +1,30 @@
+#!/bin/sh
+set -eu
+
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
+build_dir=${TMPDIR:-/tmp}/rm-appload-nativeink-host-tests
+
+mkdir -p "$build_dir"
+
+compile_and_run() {
+    source_file=$1
+    output_name=$2
+    c++ -std=c++17 -Wall -Wextra -Werror -pedantic -O2 \
+        "$repo_dir/tests/$source_file" -o "$build_dir/$output_name"
+    "$build_dir/$output_name"
+}
+
+compile_and_run nativeink_protocol_test.cpp nativeink_protocol_test
+compile_and_run nativeink_geometry_test.cpp nativeink_geometry_test
+compile_and_run qtfb_scaled_rect_test.cpp qtfb_scaled_rect_test
+
+c++ -std=c++17 -Wall -Wextra -Werror -pedantic -O2 \
+    "$repo_dir/tests/nativeink_ipc_test.cpp" \
+    "$repo_dir/src/nativeink/NativeInkIpcServer.cpp" \
+    -I"$repo_dir/src/nativeink" -o "$build_dir/nativeink_ipc_test"
+ipc_status=0
+"$build_dir/nativeink_ipc_test" || ipc_status=$?
+if [ "$ipc_status" -ne 0 ] && [ "$ipc_status" -ne 77 ]; then exit "$ipc_status"; fi
+
+echo "rm-appload native ink host tests: PASS"
diff --git a/tools/build-phase6n1-poc.sh b/tools/build-phase6n1-poc.sh
new file mode 100755
index 0000000..66f3a13
--- /dev/null
+++ b/tools/build-phase6n1-poc.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ "$(uname -s)" != Linux ]]; then
+    echo "Phase 6N-1 AppLoad build requires Linux" >&2
+    exit 2
+fi
+if [[ -z "${XOVI_REPO:-}" || ! -r "$XOVI_REPO/util/xovigen.py" ]]; then
+    echo "XOVI_REPO must point to a readable Xovi source checkout" >&2
+    exit 3
+fi
+for command_name in qmake6 rcc make readelf sha256sum; do
+    command -v "$command_name" >/dev/null || {
+        echo "missing required tool: $command_name" >&2
+        exit 4
+    }
+done
+
+repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
+artifact_dir="$repo_dir/artifacts/phase6n1"
+mkdir -p "$artifact_dir"
+
+cd "$repo_dir"
+./tests/run-host-tests.sh
+cd xovi
+./make.sh
+
+short_sha=$(git -C "$repo_dir" rev-parse --short=12 HEAD)
+artifact="$artifact_dir/appload-phase6n1-poc-${short_sha}.so"
+cp appload.so "$artifact"
+sha256sum "$artifact" >"$artifact.sha256"
+readelf -h "$artifact" | grep -E 'Class:.*ELF64'
+readelf -h "$artifact" | grep -E 'Machine:.*AArch64'
+readelf -d "$artifact" >"$artifact.dynamic.txt"
+
+printf 'artifact=%s\n' "$artifact"
+printf 'checksum=%s\n' "$(cut -d' ' -f1 "$artifact.sha256")"
